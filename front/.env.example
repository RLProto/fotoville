# Copie este arquivo para .env.local e preencha. Nunca suba o .env.local para o git.

# Endereço público do site (sem barra no final). Em produção precisa ser https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (banco e login) -------------------------------------------------
# Painel do projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# chave "anon" ou "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chave "service_role" ou "secret". Só no servidor. Nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bucket de fotos (API S3) ---------------------------------------------------
# Recomendado: Cloudflare R2 (US$ 0,015/GB/mês, sem cobrança de download, 10 GB grátis).
# R2 > Create bucket (privado) > Manage API tokens > token "Object Read & Write".
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fotoville-fotos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mercado Pago (Checkout Pro) ------------------------------------------------
# mercadopago.com.br/developers > Suas integrações > sua aplicação > Credenciais.
# Comece com o Access Token de TESTE (começa com APP_USR-, igual ao de produção).
# Troque pelo de produção só quando for vender de verdade.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks). Opcional, recomendado.
MP_WEBHOOK_SECRET=

# --- Correios (API CWS: Preço e Prazo) -------------------------------------------
# Exige contrato. Em cws.correios.com.br gere o código de acesso à API.
# Sem estas variáveis o site usa uma tabela de estimativa e marca o frete como "aprox.".
CORREIOS_USER=
CORREIOS_ACCESS_CODE=
CORREIOS_POSTAGE_CARD=
# Códigos de serviço do seu contrato (padrão: PAC 03298, SEDEX 03220)
CORREIOS_SERVICE_PAC=03298
CORREIOS_SERVICE_SEDEX=03220
# CEP de onde os pedidos são postados
SHIPPING_ORIGIN_CEP=89219370

# --- Banco direto (opcional) ----------------------------------------------------
# Só para aplicar migrações com npm run db:migrate. Supabase > Connect > Session pooler.
# Não precisa no Vercel.
DATABASE_URL=
